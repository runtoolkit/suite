{
  "id": "examplePack",
  "version": "1.0.0",
  "description": "Example datapack dependency config",

  "build": {
    "output": "both",
    "exclude": [
      ".git",
      ".github",
      ".dp-cache",
      "dist",
      "datapack_depends.json",
      "datapack_depends.lock",
      "*.md",
      "scripts/"
    ]
  },

  "dependencies": {
    "dataLib": {
      "source": "github",
      "repo": "runtoolkit/suite",
      "version": "v6.0.2",
      "asset": "dataLib-dp-datapacks-dataLib.zip"
    }
  }
}