{
  "type": "minecraft:multi_action",
  "title": {
    "text": "macroengine Input"
  },
  "body": {
    "type": "minecraft:plain_message",
    "contents": "Enter your input below."
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "macroengine_input_text",
      "label": "Input",
      "label_visible": false,
      "max_length": 2000
    }
  ],
  "can_close_with_escape": true,
  "after_action": "close",
  "pause": false,
  "actions": [
    {
      "label": {
        "text": "Submit"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "/function macroengine:input/private/dialog_capture {value:$(macroengine_input_text)}"
      }
    }
  ]
}
